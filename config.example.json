{
  "server": { "addr": ":8080" },
  "database": { "driver": "sqlite", "dsn": "epmon.db", "retention_days": 90 },
  "probes": { "default_interval": "60s", "default_timeout": "10s", "failure_threshold": 1 },
  "services": [
    {
      "id": "website",
      "name": "Website",
      "url": "https://example.com",
      "body_contains": "Example Domain"
    },
    {
      "id": "api",
      "name": "Public API",
      "url": "https://api.example.com/readyz",
      "interval": "30s",
      "expect_status": [200]
    }
  ]
}
